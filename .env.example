# Kalshi credentials. Use the API-key flow (preferred) or email+password.
KALSHI_ENV=demo                       # demo | prod
KALSHI_API_KEY_ID=
KALSHI_API_PRIVATE_KEY_PATH=          # path to PEM file for RSA-PSS signing
KALSHI_EMAIL=
KALSHI_PASSWORD=

# Bot behavior
KALSHIBOT_DRY_RUN=true                # never sends orders when true
KALSHIBOT_MAX_POSITION_USD=50         # per-market cap
KALSHIBOT_BANKROLL_USD=1000
KALSHIBOT_MIN_EDGE=0.03               # min probability edge to act
KALSHIBOT_POLL_SECONDS=30
