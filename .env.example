# -------- Kalshi API credentials --------
# Create an API key in Kalshi -> Account -> API Keys. Kalshi gives you
# a UUID (the key ID) plus a PEM-format private key. Save the PEM file
# somewhere on disk and point KALSHI_API_PRIVATE_KEY_PATH at it.
KALSHI_ENV=prod
KALSHI_API_KEY_ID=
KALSHI_API_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# -------- Bot behaviour --------
KALSHIBOT_DRY_RUN=true                 # never sends orders when true
KALSHIBOT_BANKROLL_USD=1000
KALSHIBOT_MAX_POSITION_USD=50          # per-market cap
KALSHIBOT_MIN_EDGE=0.03                # min probability edge to act
KALSHIBOT_POLL_SECONDS=10

# -------- SMS notifications (every 2 hours) --------
KALSHIBOT_PHONE=4087637531

# Option A: Twilio (recommended; ~$15 free trial credit)
KALSHIBOT_TWILIO_SID=
KALSHIBOT_TWILIO_TOKEN=
KALSHIBOT_TWILIO_FROM=

# Option B: Email-to-SMS gateway (free; carrier-specific)
#   Verizon  -> @vtext.com
#   AT&T     -> @txt.att.net
#   T-Mobile -> @tmomail.net
#   Sprint   -> @messaging.sprintpcs.com
# KALSHIBOT_NOTIFY_EMAIL=4087637531@vtext.com
# KALSHIBOT_SMTP_HOST=smtp.gmail.com
# KALSHIBOT_SMTP_PORT=587
# KALSHIBOT_SMTP_USER=you@gmail.com
# KALSHIBOT_SMTP_PASS=app-specific-password
